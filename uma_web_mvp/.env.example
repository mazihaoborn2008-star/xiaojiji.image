# ===== Web =====
APP_ORIGIN=http://127.0.0.1:8000
HOST=127.0.0.1
PORT=8000

# Discord Bot shared paths
BOT_DIR=/path/to/discord-bot
BALANCE_DB=/path/to/discord-bot/balance.db
BOT_OUTPUT_DIR=/path/to/discord-bot/output
INPUT_IMAGE_DIR=/path/to/discord-bot/input_images
OWNER_USER_ID=your_discord_user_id
OWNER_FREE_GENERATION=true
PRICE_FEN_PER_IMAGE=1
MAX_QUEUE_SIZE=20
MAX_ACTIVE_TASKS_PER_USER=3
ESTIMATED_GENERATION_SECONDS=18
ESTIMATED_AGENT_SECONDS=51
GENERATION_WORKER_COUNT=1

# ===== Optional Redis =====
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0

# ===== Content Policy =====
ADULT_CONTENT_FILTER_ENABLED=false

# ===== Auth mode =====
# Set true for local dev only; must be false on production domain
DEV_AUTH_BYPASS=false
DEV_USER_ID=your_discord_user_id
DEV_USERNAME=Dev User

# ===== Discord OAuth =====
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/auth/discord/callback
ADMIN_DISCORD_USER_ID=your_discord_user_id
FEEDBACK_DISCORD_CHANNEL_ID=

# ===== Session Cookie =====
SESSION_SECRET=
COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=604800
MAX_ACTIVE_SESSIONS_PER_ACCOUNT=10

# ===== Email OTP Login =====
EMAIL_AUTH_ENABLED=false
EMAIL_OTP_SECRET=
EMAIL_IDENTITY_SECRET=
EMAIL_ENCRYPTION_KEY=
EMAIL_OTP_EXPIRE_SECONDS=300
EMAIL_OTP_RESEND_SECONDS=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_MAX_PER_HOUR=10
EMAIL_OTP_MAX_PER_IP_PER_HOUR=20
PASSWORD_LOGIN_MAX_FAILED_ATTEMPTS=5
PASSWORD_LOGIN_LOCK_SECONDS=900
PASSWORD_LOGIN_MAX_ATTEMPTS_PER_EMAIL_15_MIN=10
PASSWORD_LOGIN_MAX_ATTEMPTS_PER_IP_15_MIN=30
PASSWORD_RESET_TOKEN_SECONDS=600
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=YourAppName
SMTP_FROM_EMAIL=
SMTP_CONNECT_TIMEOUT=10
SMTP_SEND_TIMEOUT=15
EMAIL_SEND_MAX_CONCURRENCY=2
EMAIL_SEND_TIMEOUT_SECONDS=20

# ===== Top-up Payment Methods =====
ASB_TRANSFER_ENABLED=false
ASB_BANK_NAME=ASB
ASB_PAYEE_NAME=Example Payee Name
ASB_ACCOUNT_NUMBER=00-0000-0000000-00
TOPUP_WECHAT_EXPIRES_HOURS=24
TOPUP_ASB_EXPIRES_DAYS=7
TOPUP_PAID_REVIEW_DAYS=7

# ===== Agent (Ollama local LLM) =====
AGENT_ENABLED=true
AGENT_BASE_URL=http://127.0.0.1:11434
AGENT_API_KEY=
AGENT_MODEL=qwen3.5-9b-uncensored:latest
AGENT_PROVIDER=ollama
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_CONCURRENCY=1
AGENT_KEEP_ALIVE=0
WECHAT_PAYMENT_LINK=

# ===== Referral Campaign =====
REFERRAL_CAMPAIGN_ENABLED=false
REFERRAL_CAMPAIGN_VERSION=referral_campaign_v1
REFERRAL_INVITEE_BONUS_CREDITS=10
REFERRAL_INVITER_BONUS_CREDITS=20

# ===== Smart Agent (DeepSeek, optional) =====
SMART_AGENT_ENABLED=false
SMART_AGENT_V2_ENABLED=false
SMART_AGENT_LEGACY_ENABLED=true
SMART_AGENT_COST_CREDITS=5
AGENT_SURCHARGE_CREDITS=1
SMART_AGENT_RATE_WINDOW_SECONDS=600
SMART_AGENT_CHAT_USER_LIMIT=30
SMART_AGENT_CHAT_IP_LIMIT=100
SMART_AGENT_CHAT_EMERGENCY_IP_LIMIT=300
SMART_AGENT_CHAT_EMERGENCY_WINDOW_SECONDS=600
SMART_AGENT_GENERATE_USER_LIMIT=10
SMART_AGENT_GENERATE_IP_LIMIT=40
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_CHAT_TIMEOUT_SECONDS=180
DEEPSEEK_CHAT_MAX_OUTPUT_TOKENS=4096
DEEPSEEK_MAX_RETRIES=2
FAST_TRANSLATOR_ENABLED=false
FAST_TRANSLATOR_COST_CREDITS=1
AI_SUPPORT_ENABLED=false
AI_SUPPORT_MAX_HISTORY=20
AI_SUPPORT_RATE_LIMIT_PER_MINUTE=10
MOCK_WORKER_ENABLED=false
MOCK_WORKER_POLL_SECONDS=2
MOCK_GENERATION_SECONDS=3
MOCK_OUTPUT_DIR=test_data/mock_output
SMART_AGENT_PROMPT_XLSX_PATH=/path/to/agent.xlsx
COMFYUI_WORKFLOW_DIR=/path/to/ComfyUI/user/default/workflows

# ===== Deformed Image Refund Review =====
IMAGE_REFUND_WINDOW_HOURS=24
IMAGE_REFUND_DAILY_LIMIT=5
MIMO_IMAGE_REVIEW_ENABLED=false
MIMO_IMAGE_REVIEW_MODEL=mimo-v2.5
MIMO_IMAGE_REVIEW_BASE_URL=
MIMO_IMAGE_REVIEW_API_KEY=
MIMO_IMAGE_REVIEW_TIMEOUT_SECONDS=90
MIMO_IMAGE_REVIEW_MIN_CONFIDENCE=0.85
MIMO_IMAGE_REVIEW_MIN_SEVERITY=85
